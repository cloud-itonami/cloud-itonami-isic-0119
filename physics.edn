;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": a field-management robot keeps field records,
;; schedules field operations and handles supplies for a farm growing other
;; non-perennial crops (ISIC 0119: forage crops, flowers, seeds). Its physical
;; work: moving baled forage to the barn, and watching a stacked hay bale heat
;; itself from residual moisture.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-0119"
 :cases
 [{:id :round-bale-to-barn
   :kind :transport
   :procedure "bale carrier moves one round forage bale from the field edge into the hay barn"
   :params {:mass-kg 500.0 :distance-m 200.0 :v-max-mps 2.0 :a-max-mps2 0.6
            :brake-decel-mps2 1.5 :drive-force-n 1800.0 :crr 0.08
            :cog-height-m 0.70 :support-half-length-m 0.70 :max-time-s 3600.0}
   :sweep {:param :payload-kg :values [250.0 400.0 550.0 700.0 850.0]}
   :quantity :cycle-time-s
   :limit {:max 130.0 :basis "estimate: one bale per leg while the baler drops a bale every ~2 minutes"}
   :boundary {:lo 50.0 :hi 2000.0}}
  {:id :hay-bale-self-heating
   :kind :thermal
   :procedure "a stacked hay bale baled too wet generates heat from microbial respiration; the bale core is judged over two weeks"
   :params {:thickness-m 0.60 :conductivity-w-mk 0.06 :density-kg-m3 180.0 :specific-heat-j-kgk 1900.0
            :t0-c 20.0 :t-hot-c 20.0 :h-front-w-m2k 8.0 :t-back-ambient-c 20.0 :h-back-w-m2k 0.0
            :threshold-c 65.0 :duration-s 1209600.0 :nodes 11}
   :sweep {:param :q-gen-w-m3 :values [1.0 5.0 10.0 20.0 30.0]}
   :quantity :peak-back-c
   :limit {:max 65.0 :basis "estimate: hay core above ~65 C is treated as a fire-risk alarm level (pure conduction, constant heat generation)"}
   :boundary {:lo 0.1 :hi 20.0}}]}
